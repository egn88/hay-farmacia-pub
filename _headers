# Cloudflare Pages cache rules (same policy as infra/nginx.conf.example)

/data/latest.json
  Cache-Control: no-cache

/farmacias-de-guardia/*
  Cache-Control: public, max-age=1800

/sitemap.xml
  Cache-Control: public, max-age=1800

/data/master.*.json
  Cache-Control: public, max-age=31536000, immutable

/data/duty.*.json
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
